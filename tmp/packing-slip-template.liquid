{% comment %} https://admin.shopify.com/store/petalscom/settings/shipping/packing_slip_template {% endcomment %}
{% comment %}
  Backorder line item property keys (legacy + current):
  - Backorder  (current)
  - Backorder: (legacy — key included a trailing colon)
  - Backorder Message (original)
  - zero-width space (U+200B) (brief transitional)
{% endcomment %}
<div class="wrapper">
  <div class="header">
    <div class="shop-title">
      <p class="to-uppercase">

  <img src="https://cdn.shopify.com/s/files/1/0626/3681/8505/files/petals_logo.svg?v=1774379282" style="width:100px; height: auto;">

      </p>
    </div>
    <div class="order-title">
      <p class="text-align-right">Order {{ order.name }}</p>
      {% if order.po_number != blank %}
        <p class="text-align-right">PO number #{{ order.po_number }}</p>
      {% endif %}
      <p class="text-align-right">
        {{ order.created_at | date: format: 'date' }}
      </p>
    </div>
  </div>
  <div class="customer-addresses">
    <div class="shipping-address">
      <p class="subtitle-bold to-uppercase">
        {% if delivery_method.instructions != blank %}
          Delivery to
        {% else %}
          Ship to
        {% endif %}
      </p>
      <p class="address-detail">
        {% if shipping_address != blank %}
          {{ shipping_address.name }}
          {% if shipping_address.company != blank %}
            <br>
            {{ shipping_address.company }}
          {% endif %}
          <br>
          {{ shipping_address.address1 }}
          {% if shipping_address.address2 != blank %}
            <br>
            {{ shipping_address.address2 }}
          {% endif %}
          {% if shipping_address.city_province_zip != blank %}
            <br>
            {{ shipping_address.city_province_zip }}
          {% endif %}
          <br>
          {{ shipping_address.country }}
          {% if shipping_address.phone != blank %}
            <br>
            {{ shipping_address.phone }}
          {% endif %}
        <br><br><strong class="subtitle-bold to-uppercase">Shipping Method: {{ order.shipping_method.title }}</strong>
        {% else %}
          No shipping address
        {% endif %}
      </p>
    </div>
    <div class="billing-address">
      <p class="subtitle-bold to-uppercase">Bill to</p>
      <p class="address-detail">
        {% if billing_address != blank %}
          {{ billing_address.name }}
          {% if billing_address.company != blank %}
            <br>
            {{ billing_address.company }}
          {% endif %}
          <br>
          {{ billing_address.address1 }}
          {% if billing_address.address2 != blank %}
            <br>
            {{ billing_address.address2 }}
          {% endif %}
          {% if billing_address.city_province_zip != blank %}
            <br>
            {{ billing_address.city_province_zip }}
          {% endif %}
          <br>
          {{ billing_address.country }}
        {% else %}
          No billing address
        {% endif %}
      </p>
    </div>
  </div>
  <hr>
  <div class="order-container">
    <div class="order-container-header">
      <div class="order-container-header-left-content">
        <p class="subtitle-bold to-uppercase">Items</p>
      </div>
      <div class="order-container-header-right-content">
        <p class="subtitle-bold to-uppercase">Quantity</p>
      </div>
    </div>

    {% comment %}
      To adjust the size of line item images, change desired_image_size.
      The other variables make sure your images print at high quality.
    {% endcomment %}
    {% assign desired_image_size = 58 %}
    {% assign resolution_adjusted_size = desired_image_size | times: 300 | divided_by: 72 | ceil %}
    {% capture effective_image_dimensions %}
      {{ resolution_adjusted_size }}x{{ resolution_adjusted_size }}
    {% endcapture %}

    {% comment %}
      Nest each container under the plant that selected it.

      Two of the same variant (two Large poinsettias) store the same
      _parent_variant_id on each pot, so that id is not a unique key.
      When more than one unassigned container has the parent's variant,
      pick the one whose title equals Selected Container. When exactly
      one does, use it. Key each container by its position in this
      shipment so the second pot is not treated as already printed.

      Packing slip lines often lack variant_id; resolve it from the order
      by SKU, then title. Do not match on title/group "contains", and do
      not attach whatever container is the only one left in the shipment.
    {% endcomment %}
    {% assign assigned_container_keys = "" %}
    {% for line_item in line_items_in_shipment %}
      {% unless line_item.properties["_is_container"] == 'true' %}
        {% assign has_associated_container = false %}
        {% assign associated_container = nil %}
        {% assign associated_container_key = "" %}
        {% if line_item.properties["Selected Container"] != blank %}
          {% assign line_variant_id = line_item.variant_id | append: '' | strip %}
          {% if line_variant_id == blank and order.line_items %}
            {% for order_line in order.line_items %}
              {% unless order_line.properties["_is_container"] == 'true' %}
                {% if order_line.sku != blank and order_line.sku == line_item.sku %}
                  {% assign line_variant_id = order_line.variant_id | append: '' | strip %}
                  {% break %}
                {% endif %}
              {% endunless %}
            {% endfor %}
            {% if line_variant_id == blank %}
              {% for order_line in order.line_items %}
                {% unless order_line.properties["_is_container"] == 'true' %}
                  {% if order_line.title == line_item.title %}
                    {% assign line_variant_id = order_line.variant_id | append: '' | strip %}
                    {% break %}
                  {% endif %}
                {% endunless %}
              {% endfor %}
            {% endif %}
          {% endif %}

          {% assign selected_container_label = line_item.properties["Selected Container"] | split: ' (+ ' | first | strip %}
          {% assign selected_container_label = selected_container_label | split: ' + $' | first | strip %}
          {% assign selected_container_label = selected_container_label | split: ' (FREE)' | first | strip %}

          {% assign parent_pool_count = 0 %}
          {% assign title_match_index = 0 %}
          {% assign only_pool_index = 0 %}

          {% for container_line in line_items_in_shipment %}
            {% if container_line.properties["_is_container"] == 'true' %}
              {% assign container_key = '|L' | append: forloop.index | append: '|' %}
              {% unless assigned_container_keys contains container_key %}
                {% assign container_parent_id = container_line.properties["_parent_variant_id"] | append: '' | strip %}
                {% if line_variant_id != blank and container_parent_id == line_variant_id %}
                  {% assign parent_pool_count = parent_pool_count | plus: 1 %}
                  {% assign only_pool_index = forloop.index %}
                  {% assign container_title = container_line.title | strip %}
                  {% if title_match_index == 0 and selected_container_label != blank and container_title == selected_container_label %}
                    {% assign title_match_index = forloop.index %}
                  {% endif %}
                {% endif %}
              {% endunless %}
            {% endif %}
          {% endfor %}

          {% assign matched_index = 0 %}
          {% if title_match_index > 0 %}
            {% assign matched_index = title_match_index %}
          {% elsif parent_pool_count == 1 %}
            {% assign matched_index = only_pool_index %}
          {% endif %}

          {% if matched_index > 0 %}
            {% for container_line in line_items_in_shipment %}
              {% if forloop.index == matched_index %}
                {% assign has_associated_container = true %}
                {% assign associated_container = container_line %}
                {% assign associated_container_key = '|L' | append: forloop.index | append: '|' %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% elsif line_variant_id == blank and selected_container_label != blank %}
            {% for container_line in line_items_in_shipment %}
              {% if container_line.properties["_is_container"] == 'true' %}
                {% assign container_key = '|L' | append: forloop.index | append: '|' %}
                {% unless assigned_container_keys contains container_key %}
                  {% assign container_title = container_line.title | strip %}
                  {% if container_title == selected_container_label %}
                    {% assign has_associated_container = true %}
                    {% assign associated_container = container_line %}
                    {% assign associated_container_key = container_key %}
                    {% break %}
                  {% endif %}
                {% endunless %}
              {% endif %}
            {% endfor %}
          {% endif %}
        {% endif %}

        <div class="flex-line-item{% if has_associated_container %} flex-line-item--parent{% endif %}">
          <!--<div class="flex-line-item-img">
            {% if line_item.image != blank %}
              <div
                class="aspect-ratio aspect-ratio-square"
                style="width: {{ desired_image_size }}px; height: {{ desired_image_size }}px;"
              >
                {{ line_item.image | img_url: effective_image_dimensions | img_tag: '', 'aspect-ratio__content' }}
              </div>
            {% endif %}
          </div>-->
          <div class="flex-line-item-description">
            <p>
              <span class="line-item-description-line">
                {{ line_item.sku }} {{ line_item.title }} {{ line_item.variant_title }}
              </span>
              <!--
              {% if line_item.variant_title != blank %}
                <span class="line-item-description-line">
                  {{ line_item.variant_title }}
                </span>
              {% endif %}
              -->
              {% comment %}
              {% liquid
                assign whirlwind_backorder_message = line_item.properties['Backorder']
                if whirlwind_backorder_message == blank
                  assign whirlwind_backorder_message = line_item.properties['Backorder Message']
                endif
                if whirlwind_backorder_message == blank
                  assign whirlwind_backorder_message = line_item.properties['​']
                endif
                if whirlwind_backorder_message == blank and order.line_items
                  for order_line in order.line_items
                    if order_line.sku != blank and order_line.sku == line_item.sku
                      assign whirlwind_backorder_message = order_line.properties['Backorder']
                      if whirlwind_backorder_message == blank
                        assign whirlwind_backorder_message = order_line.properties['Backorder Message']
                      endif
                      if whirlwind_backorder_message == blank
                        assign whirlwind_backorder_message = order_line.properties['​']
                      endif
                      break
                    endif
                  endfor
                endif
              %}
              {% if whirlwind_backorder_message != blank %}
                <span class="line-item-description-line">
                  Backorder: {{ whirlwind_backorder_message }}
                </span>
              {% endif %}
              {% endcomment %}
              <!--{% if line_item.sku != blank %}
                <span class="line-item-description-line">
                  Item #: {{ line_item.sku }}
                </span>
              {% endif %}-->
              {% for group in line_item.groups %}
                {% if group.deliverable? %}
                  <span class="line-item-description-line line-item-description-line-group"> For: {{ group.title }} </span>
                {% else %}
                  <span class="line-item-description-line line-item-description-line-group"> Part of: {{ group.title }} </span>
                {% endif %}
              {% endfor %}
            </p>
          </div>
          <div class="flex-line-item-quantity">
            <p class="text-align-right">{{ line_item.shipping_quantity }} of {{ line_item.quantity }}</p>
          </div>
        </div>

        {% if has_associated_container %}
          {% assign child_line = associated_container %}
          {% assign assigned_container_keys = assigned_container_keys | append: associated_container_key %}
          <div class="flex-line-item flex-line-item--nested">
            <!--<div class="flex-line-item-img">
              {% if child_line.image != blank %}
                <div
                  class="aspect-ratio aspect-ratio-square"
                  style="width: {{ desired_image_size }}px; height: {{ desired_image_size }}px;"
                >
                  {{ child_line.image | img_url: effective_image_dimensions | img_tag: '', 'aspect-ratio__content' }}
                </div>
              {% endif %}
            </div>
            -->
            <div class="flex-line-item-description">
              <p>
                <span class="line-item-description-line">
                  {{ child_line.sku }} {{ child_line.title }} {{ child_line.variant_title }}
                </span>
                <!--
                {% if child_line.variant_title != blank and child_line.variant_title != 'Default Title' %}
                  <span class="line-item-description-line">
                    {{ child_line.variant_title }}
                  </span>
                {% endif %}
                -->
                <!--
                {% if child_line.sku != blank %}
                  <span class="line-item-description-line">
                    Item #: {{ child_line.sku }}
                  </span>
                {% endif %}-->
              </p>
            </div>
            <div class="flex-line-item-quantity flex-line-item-quantity-child">
              <p class="text-align-right">{{ child_line.shipping_quantity }} of {{ child_line.quantity }}</p>
            </div>
          </div>
        {% endif %}
      {% endunless %}
    {% endfor %}

    {% comment %}
      Container-only shipments (leftover Ohio box after the plant already shipped)
      are skipped by the parent loop. Print any _is_container line that was not
      nested under a parent in this shipment.
    {% endcomment %}
    {% for leftover_line in line_items_in_shipment %}
      {% if leftover_line.properties["_is_container"] == 'true' %}
        {% assign leftover_key = '|L' | append: forloop.index | append: '|' %}
        {% unless assigned_container_keys contains leftover_key %}
          <div class="flex-line-item">
            <div class="flex-line-item-description">
              <p>
                <span class="line-item-description-line">
                  {{ leftover_line.sku }} {{ leftover_line.title }} {{ leftover_line.variant_title }}
                </span>
                {% for group in leftover_line.groups %}
                  {% if group.deliverable? %}
                    <span class="line-item-description-line line-item-description-line-group"> For: {{ group.title }} </span>
                  {% else %}
                    <span class="line-item-description-line line-item-description-line-group"> Part of: {{ group.title }} </span>
                  {% endif %}
                {% endfor %}
              </p>
            </div>
            <div class="flex-line-item-quantity">
              <p class="text-align-right">{{ leftover_line.shipping_quantity }} of {{ leftover_line.quantity }}</p>
            </div>
          </div>
          {% assign assigned_container_keys = assigned_container_keys | append: leftover_key %}
        {% endunless %}
      {% endif %}
    {% endfor %}
  </div>
  {% unless includes_all_line_items_in_order %}
    <hr class="subdued-separator">
    <p class="missing-line-items-text ">There are other items from your order not included in this shipment.</p>
  {% endunless %}
  <hr>
  {% if order.note != blank %}
    <div class="notes">
      <p class="subtitle-bold to-uppercase">
        Gift Message
      </p>
      <p class="notes-details">
        {{ order.note }}
      </p>
    </div>
  {% endif %}
  {% if delivery_method.instructions != blank %}
    <div class="notes">
      <p class="subtitle-bold to-uppercase">Delivery instructions</p>
      <p class="notes-details">
        {{ delivery_method.instructions }}
      </p>
    </div>
  {% endif %}
  <div class="footer">
    <p>Thank you for shopping with us!</p>
    <p>
      <strong>
        {{ shop.name }}
      </strong>
      <br>
      {{ shop_address.summary }}
      <br>
      <strong>Customer Service, Returns or Exchange:</strong>
      <br>
      Call 1-800-783-9966 (M-F 8AM-7PM ET) or email us <a href="mailto:service@petals.com">service@petals.com</a>
      <br>
      {{ shop.domain }}
    </p>
  </div>
</div>

<style type="text/css">
  body {
    font-size: 16px;
  }

  * {
    box-sizing: border-box;
  }

  strong {font-weight: 800;}

  .wrapper {
    width: 831px;
    margin: auto;
    padding: 4em;
    font-family: "Noto Sans", sans-serif;
    font-weight: 250;
  }

  .header {
    width: 100%;
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    flex-direction: row;
    align-items: top;
  }

  .header p {
    margin: 0;
  }

  .shop-title {
    -webkit-box-flex: 6;
    -webkit-flex: 6;
    flex: 6;
    font-size: 1.9em;
  }

  .order-title {
    -webkit-box-flex: 4;
    -webkit-flex: 4;
    flex: 4;
  }

  .customer-addresses {
    width: 100%;
    display: flex;
    gap: 10px;
    margin: 2em 0;
  }

  .address-detail {
    margin: 0.7em 0 0;
    line-height: 1.5;
  }

  .subtitle-bold {
    font-weight: bold;
    margin: 0;
    font-size: 0.85em;
  }

  .to-uppercase {
    text-transform: uppercase;
  }

  .text-align-right {
    text-align: right;
  }

  .shipping-address {
    min-width: 18em;
    flex-grow: 1;
  }

  .billing-address {
    /*padding-left: 20em;
    min-width: 18em;*/
    white-space: nowrap;
  }


  .order-container {
    padding: 0 0.7em;
    margin-bottom: 10px;
  }

  .order-container-header {
    display: inline-block;
    width: 100%;
    margin-top: 1.4em;
  }

  .order-container-header-left-content {
    float: left;
  }

  .order-container-header-right-content {
    float: right;
  }

  .flex-line-item {
    display: -webkit-box;
    display: -webkit-flex;
    display: flex;
    flex-direction: row;
    align-items: flex-start; /*center; */
    margin: .5em 0;/*1.4em 0;*/
    padding-top: .5em;
    page-break-inside: avoid;
  }

  .flex-line-item:not(.flex-line-item--nested){
        border-top: 1px dotted #ccc;
  }

  .flex-line-item--nested {
    margin-top: 0px;
    margin-bottom: 0px; /*1.4em;*/
    padding-left: 2.8em;

  }

  .flex-line-item--parent {
    margin-bottom: 0px; /* 0.7em; */

  }

  .flex-line-item--nested .flex-line-item-img .aspect-ratio {
    width: 42px !important;
    height: 42px !important;
  }

  .flex-line-item--nested .flex-line-item-img {
    min-width: 42px;
  }

  .flex-line-item-img {
    margin-right: 1.4em;
    min-width: {{ desired_image_size }}px;
  }

  .flex-line-item-description {
    -webkit-box-flex: 9;
    -webkit-flex: 9;
    flex: 9;

  }

  .line-item-description-line {
    display: block;
    width: 100%;
  }




  .flex-line-item-description p {
    margin: 0;
    line-height: 1.25; /* 1.5; */

  }

  .flex-line-item-quantity {
    -webkit-box-flex: 1;
    -webkit-flex: 1;
    flex: 1;
  }

    .flex-line-item-quantity p {margin: 0px;}

  .subdued-separator {
    height: 0.07em;
    border: none;
    color: lightgray;
    background-color: lightgray;
    margin: 0;
  }

  .missing-line-items-text {
    margin: 1.4em 0;
    padding: 0 0.7em;
  }

  .notes {
    margin-top: 2em;
  }

  .notes p {
    margin-bottom: 0;
  }

  .notes .notes-details {
    margin-top: 0.7em;
  }

  .footer {
    margin-top: 2em;
    text-align: center;
    line-height: 1.5;
  }

  .footer p {
    margin: 0;
    margin-bottom: 1.4em;
  }

  hr {
    height: 0.14em;
    border: none;
    color: black;
    background-color: black;
    margin: 0;
  }

  .aspect-ratio {
    position: relative;
    display: block;
    background: #fafbfc;
    padding: 0;
  }

  .aspect-ratio::before {
    z-index: 1;
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    border: 1px solid rgba(195,207,216,0.3);
  }

  .aspect-ratio--square {
    width: 100%;
    padding-bottom: 100%;
  }

  .aspect-ratio__content {
    position: absolute;
    max-width: 100%;
    max-height: 100%;
    display: block;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    margin: auto;
  }
</style>
