    "custom_liquid_epeUtD": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "HP-04bv2 Thanksgiving-Countdown-2026",
      "settings": {
        "custom_liquid": "<div class=\"petals-thanksgiving-countdown\">\n  <div class=\"petals-countdown-inner\">\n    <div class=\"petals-countdown-copy\">\n      <div class=\"petals-countdown-eyebrow\">\n        THE COUNTDOWN TO THANKSGIVING\n      </div>\n      <p>A beautiful Thanksgiving table begins here.</p>\n    </div>\n\n    <div class=\"petals-countdown-main\">\n      <span id=\"petals-thanksgiving-days\">--</span>\n      <span class=\"petals-countdown-label\">DAYS TO GATHER</span>\n    </div>\n  </div>\n</div>\n\n<style>\n.petals-thanksgiving-countdown {\n  background: #FBF8F3;\n  padding: 22px 30px;\n  font-family: Inter, sans-serif;\n}\n\n.petals-countdown-inner {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 45px;\n  max-width: 1100px;\n  margin: 0 auto;\n}\n\n.petals-countdown-copy {\n  text-align: left;\n}\n\n.petals-countdown-eyebrow {\n  color: #5F6B52;\n  font-size: 12px;\n  font-weight: 600;\n  letter-spacing: .12em;\n}\n\n.petals-countdown-copy p {\n  color: #666666;\n  font-size: 14px;\n  margin: 6px 0 0;\n}\n\n.petals-countdown-main {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  border-left: 1px solid #D9DDD2;\n  padding-left: 45px;\n  white-space: nowrap;\n}\n\n#petals-thanksgiving-days {\n  color: #5F6B52;\n  font-family: \"Playfair Display\", Georgia, serif;\n  font-size: 52px;\n  line-height: 1;\n}\n\n.petals-countdown-label {\n  color: #5F6B52;\n  font-size: 13px;\n  font-weight: 600;\n  letter-spacing: .08em;\n}\n\n@media (max-width: 650px) {\n  .petals-thanksgiving-countdown {\n    padding: 20px 15px;\n  }\n\n  .petals-countdown-inner {\n    flex-direction: column;\n    gap: 12px;\n  }\n\n  .petals-countdown-copy {\n    text-align: center;\n  }\n\n  .petals-countdown-main {\n    border-left: none;\n    padding-left: 0;\n    gap: 10px;\n  }\n\n  #petals-thanksgiving-days {\n    font-size: 42px;\n  }\n}\n</style>\n\n<script>\n(function () {\n  function updateThanksgivingCountdown() {\n    const el = document.getElementById('petals-thanksgiving-days');\n    if (!el) return;\n\n    const thanksgiving = new Date('2026-11-26T00:00:00-05:00');\n    const remaining = thanksgiving.getTime() - Date.now();\n    const days = Math.max(0, Math.ceil(remaining / 86400000));\n\n    el.textContent = days;\n\n    if (remaining <= 0) {\n      const section = el.closest('.petals-thanksgiving-countdown');\n      if (section) section.style.display = 'none';\n    }\n  }\n\n  updateThanksgivingCountdown();\n  setInterval(updateThanksgivingCountdown, 60000);\n})();\n</script>",
        "full_width": false,
        "show_section_divider": false,
        "padding_top": 4,
        "padding_bottom": 4,
